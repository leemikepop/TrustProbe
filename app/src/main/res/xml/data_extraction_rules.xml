<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer. Test history (the database) and the
     cache (hev.yaml holds the session's SOCKS5 password) never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="root" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="root" path="cache/" />
    </device-transfer>
</data-extraction-rules>
